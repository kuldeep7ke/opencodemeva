{
  "name": "opencodemeva",
  "version": "1.0.0",
  "description": "Patch installer + curated option pack for opencode: agents, commands, skills, plugins, MCP, LSP. Free and open source.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "bin": {
    "opencodemeva": "src/cli.js"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs options",
    "test": "node scripts/test-cli.mjs",
    "build": "npm run validate && npm pack"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src/",
    "scripts/",
    "options/",
    "install.ps1",
    "install.sh",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "opencode",
    "agents",
    "skills",
    "plugins",
    "mcp",
    "lsp",
    "cli"
  ]
}